{
  "name": "sfc-shipping-tools",
  "description": "Open-source Shopify storefront UI for SFC rates, tracking, account review, and shipment creation.",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuntekCorps-xLab/sfc-shipping-tools.git"
  },
  "scripts": {
    "build": "react-router build",
    "build:storefront": "node scripts/build-storefront.mjs",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint app extensions/storefront-tools/src scripts/build-storefront.mjs tests playwright.config.js vite.config.ts vitest.config.js --cache --cache-location ./node_modules/.cache/eslint",
    "shopify": "shopify",
    "prisma": "prisma",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "prisma:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:storefront && npm run build && npm run test:e2e"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "isbot": "^5.1.31",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0"
  },
  "devDependencies": {
    "@shopify/cli": "^4.5.2",
    "@shopify/polaris-types": "1.0.1",
    "@playwright/test": "^1.62.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.5.2",
    "@types/react": "18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.0"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0",
    "brace-expansion@<2.0.0": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "js-yaml@<4.3.1": "4.3.1",
    "minimatch@>=9.0.0 <9.0.7": "9.0.7",
    "deepmerge-ts": "8.0.2"
  },
  "version": "1.0.0",
  "bugs": {
    "url": "https://github.com/SuntekCorps-xLab/sfc-shipping-tools/issues"
  },
  "homepage": "https://github.com/SuntekCorps-xLab/sfc-shipping-tools#readme"
}
