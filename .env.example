# Local Shopify app-shell development only. Do not add SFC credentials here.
#
# These variables are loaded by `shopify app dev`. The production start script
# (`npm start` -> react-router-serve) does NOT auto-load this file, so export
# the same variables in the environment before running it.

# Prisma session-store datasource (required by `prisma generate` / `migrate`).
# Resolved relative to prisma/, so this creates prisma/dev.sqlite.
DATABASE_URL=file:./dev.sqlite

# Shopify app credentials and URL.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://127.0.0.1:4180

# Comma-separated Shopify API scopes requested at install (read by app/shopify.server.ts).
SCOPES=

# Optional: restrict the app to a single shop domain (read by app/shopify.server.ts).
# SHOP_CUSTOM_DOMAIN=your-shop.myshopify.com
